# Environment Mode: development / production
ENVIRONMENT=development
PORT=8000

# Database Persistence Configuration:
# 1. PostgreSQL (Recommended for permanent persistence on Vercel / Neon / Supabase):
#    Format: postgresql://<username>:<password>@<host>/<database>?sslmode=require
#    Example Neon: DATABASE_URL=postgresql://neondb_owner:npg_xxx@ep-proud-dawn-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
#    Example Supabase: DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=

# 2. SQLite (Default for local development and transient Vercel /tmp):
DB_PATH=backend/data/neuraldesk.db

# Vector Retrieval Configuration:
EMBEDDING_DIMENSIONS=128
SIMILARITY_THRESHOLD=0.15
